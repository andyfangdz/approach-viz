{
  "name": "approach-viz",
  "version": "1.0.0",
  "description": "3D visualization for instrument approach procedures",
  "type": "module",
  "scripts": {
    "download-data": "bash scripts/download-data.sh",
    "build-db": "tsx scripts/build-db.ts",
    "prepare-data": "npm run download-data && npm run build-db",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:parser && npm run test:geometry && npm run test:layers && npm run test:mrms",
    "test:parser": "node --import tsx --test lib/cifp/parser.test.ts",
    "test:geometry": "node --import tsx --test app/scene/approach-path/geometry.test.ts",
    "test:layers": "node --import tsx --test app/app-client/__tests__/layers-url.test.ts",
    "test:mrms": "node --import tsx --test app/scene/nexrad/nexrad.test.ts",
    "test:integration:runtime": "node --import tsx --test services/runtime-rs/runtime.integration.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "[ -f data/approach-viz.sqlite ] || npm run prepare-data; node scripts/dev-with-ddtrace.mjs",
    "build": "npm run prepare-data && next build",
    "start": "next start",
    "build:wasm": "PATH=$HOME/.cargo/bin:$PATH wasm-pack build crates/approach-viz-core --target web --out-dir ../../packages/approach-viz-core-wasm -- --features wasm && cp packages/approach-viz-core-wasm/approach_viz_core_bg.wasm public/approach_viz_core_bg.wasm && cp packages/approach-viz-core-wasm/approach_viz_core.js public/approach_viz_core.js",
    "test:smoke": "npx playwright test pw-wasm-smoke --config .tmp/playwright.config.ts",
    "codegen:flatbuffers": "bash scripts/install-flatc.sh && tools/flatc --rust -o crates/approach-viz-core/src/generated/ schemas/*.fbs"
  },
  "keywords": [
    "aviation",
    "instrument-approach",
    "cifp",
    "three.js"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@datadog/browser-rum": "^6.25.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@takram/three-geospatial": "^0.6.0",
    "@vercel/analytics": "^1.6.1",
    "3d-tiles-renderer": "^0.4.21",
    "better-sqlite3": "^11.8.1",
    "dd-trace": "^5.85.0",
    "egm96-universal": "^1.1.1",
    "next": "^16.1.6",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-select": "^5.10.2",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "25.2.1",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.182.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.1",
    "prettier": "^3.8.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2"
  }
}
