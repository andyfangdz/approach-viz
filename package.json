{
  "name": "approach-viz",
  "version": "1.0.0",
  "description": "3D visualization for instrument approach procedures",
  "type": "module",
  "scripts": {
    "download-data": "bash scripts/download-data.sh",
    "build-db": "tsx scripts/build-db.ts",
    "prepare-data": "npm run download-data && npm run build-db",
    "lint": "eslint . && node --import tsx node_modules/oxlint/bin/oxlint",
    "lint:anti-slop": "node --import tsx node_modules/oxlint/bin/oxlint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:parser && npm run test:geometry && npm run test:layers && npm run test:mrms && npm run test:workers && npm run test:routes && npm run test:references",
    "test:references": "node --import tsx --test scripts/resolve-approach-references.test.ts",
    "test:routes": "node --import tsx --test app/api/traffic/adsbx/route.test.ts app/api/faa-plate/route.test.ts app/api/weather/nexrad/runtime-proxy.test.ts",
    "test:parser": "node --import tsx --test lib/cifp/parser.test.ts lib/dof/parser.test.ts",
    "test:geometry": "node --import tsx --test app/scene/approach-path/geometry.test.ts app/scene/approach-path/geometry-rust.test.ts app/scene/terrain/terrarium.test.ts",
    "test:layers": "node --import tsx --test app/app-client/__tests__/layers-url.test.ts app/scene/obstacle-shapes.test.ts lib/obstacles/plate-significance.test.ts app/app-client/__tests__/options-state.test.ts",
    "test:mrms": "node --import tsx --test app/scene/nexrad/nexrad.test.ts",
    "test:workers": "node --import tsx --test app/scene/shared/comlinked-worker-client.test.ts",
    "test:integration:runtime": "node --import tsx --test services/runtime-rs/runtime.integration.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:sw": "esbuild sw/service-worker.ts --bundle --format=iife --outfile=public/service-worker.js --minify",
    "dev": "npm run build:sw && { [ -f data/approach-viz.sqlite ] || npm run prepare-data; } && node scripts/dev-with-ddtrace.mjs",
    "build": "npm run build:sw && npm run prepare-data && next build",
    "build:ios": "bash scripts/build-ios-app.sh",
    "build:ios:force": "bash scripts/build-ios-app.sh --force",
    "run:ios": "bash scripts/run-ios-app.sh",
    "build:macos": "bash scripts/build-macos-app.sh",
    "run:macos": "bash scripts/run-macos-app.sh",
    "test:ios": "bash scripts/test-ios.sh",
    "test:macos": "bash scripts/test-macos.sh",
    "open:ios": "bash scripts/build-ios-app.sh --project-only && open -a Xcode ios/ApproachViz.xcodeproj",
    "dev:ios": "bash scripts/build-ios-app.sh --project-only && open -a Simulator && open -a Xcode ios/ApproachViz.xcodeproj",
    "start": "next start",
    "build:wasm": "PATH=$HOME/.cargo/bin:$PATH wasm-pack build crates/approach-viz-core --target web --out-dir ../../packages/approach-viz-core-wasm -- --features wasm && cp packages/approach-viz-core-wasm/approach_viz_core_bg.wasm public/approach_viz_core_bg.wasm && cp packages/approach-viz-core-wasm/approach_viz_core.js public/approach_viz_core.js",
    "test:smoke": "npx playwright test pw-wasm-smoke --config .tmp/playwright.config.ts",
    "codegen:flatbuffers": "bash scripts/install-flatc.sh && tools/flatc --rust -o crates/approach-viz-core/src/generated/ schemas/*.fbs"
  },
  "keywords": [
    "aviation",
    "instrument-approach",
    "cifp",
    "three.js"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@datadog/browser-rum": "^6.25.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@takram/three-geospatial": "^0.6.0",
    "@vercel/analytics": "^1.6.1",
    "3d-tiles-renderer": "^0.4.21",
    "better-sqlite3": "^11.8.1",
    "comlink": "^4.4.2",
    "dd-trace": "^5.85.0",
    "egm96-universal": "^1.1.1",
    "next": "^16.1.6",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-select": "^5.10.2",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.78.0",
    "@playwright/test": "^1.58.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "25.2.1",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.182.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.1",
    "oxlint": "^1.78.0",
    "oxlint-plugin-anti-slop": "git+https://github.com/dmmulroy/anti-slop.git#446268e5d15baa968eaec669ff65358d36ae6259",
    "prettier": "^3.8.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "workbox-core": "^7.4.0",
    "workbox-expiration": "^7.4.0",
    "workbox-routing": "^7.4.0",
    "workbox-strategies": "^7.4.0"
  }
}
